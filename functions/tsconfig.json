{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "isolatedModules": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"]
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
