# Public client configuration only. No service-account, TMDB or signing secrets.
# With no values, local development uses demo emulators and guest play only.
APP_VARIANT=development
FIREBASE_PROJECTID_DEV=demo-talkie-trivia
# Optional for a physical device: LAN hostname/IP (no scheme/port).
# FIREBASE_EMULATOR_HOST=192.168.1.10

# Both public IDs are required for any live build and MUST differ.
FIREBASE_PROJECTID=
FIREBASE_PROJECTID_PREVIEW=

# Production public Firebase/OAuth application configuration:
FIREBASE_APIKEY=
FIREBASE_APPID=
FIREBASE_MESSAGING_SENDERID=
CLIENTID_IOS=
CLIENTID_ANDROID=
CLIENTID_WEB=

# Separate staging application configuration (never falls back to production):
FIREBASE_APIKEY_PREVIEW=
FIREBASE_APPID_PREVIEW=
FIREBASE_MESSAGING_SENDERID_PREVIEW=
CLIENTID_IOS_PREVIEW=
CLIENTID_ANDROID_PREVIEW=
CLIENTID_WEB_PREVIEW=

# Optional local Google provider configuration; all three needed to enable it.
# CLIENTID_IOS_DEV=
# CLIENTID_ANDROID_DEV=
# CLIENTID_WEB_DEV=
