rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
        && !exists(/databases/$(database)/documents/accountMergeLocks/$(uid));
    }
    function validPlayer(uid) {
      return request.resource.data.keys().hasOnly(['id', 'name'])
        && request.resource.data.id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;
    }
    match /players/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlayer(uid);
      allow delete: if false;
      match /games/{gameId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /privateStats/{statsId} {
        allow get: if isOwner(uid);
        allow write: if false;
      }
      match /gameHistory/{dateId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /gameHistoryV2/{dateId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit != null && request.query.limit <= 21;
        allow write: if false;
      }
      match /mergedGuestGames/{archiveId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit != null && request.query.limit <= 21;
        allow write: if false;
      }
    }
    // Only startGame selects the current challenge. No future schedule enumeration.
    // Legacy movie content/games/stats and administrative collections are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
