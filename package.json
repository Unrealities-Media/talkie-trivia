{
  "name": "talkie-trivia",
  "version": "1.0.0",
  "main": "index.tsx",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unrealities/talkie-trivia.git"
  },
  "license": "MIT",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    }
  },
  "scripts": {
    "beta:build": "node scripts/web-beta.cjs build",
    "beta:deploy": "node scripts/web-beta.cjs deploy",
    "test:beta": "node --test scripts/web-beta.test.cjs",
    "dev": "node scripts/local-dev.cjs",
    "dev:backend": "node scripts/local-dev.cjs --backend-only",
    "dev:day": "node scripts/local-demo.cjs",
    "test:local-dev": "node --test scripts/local-demo.test.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src functions/src __tests__ index.tsx --max-warnings=0",
    "test:scripts": "node --test scripts/*.test.cjs",
    "check:architecture": "node scripts/check-architecture.cjs",
    "build:web": "expo export --platform web --output-dir dist-ci",
    "test:config": "node --test scripts/app-environment.test.cjs scripts/web-beta.test.cjs scripts/react-native-source.test.cjs scripts/reconcile-account-merge.test.cjs scripts/notification-clock.test.cjs scripts/fbjni-source.test.cjs",
    "test:dependencies": "node --test scripts/dependency-contracts.test.cjs",
    "native:generate": "node scripts/native-prebuild.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/arvo": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "dotenv": "^18.0.7",
    "expo": "~57.0.28",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.15",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~58.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "fast-fuzzy": "^1.12.0",
    "firebase": "^13.0.0",
    "immer": "^11.1.21",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "babel-jest": "~29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "xmlhttprequest": "^1.8.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "$decode-uri-component"
  }
}
